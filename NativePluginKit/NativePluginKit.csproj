<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>NativePluginKit</RootNamespace>
	<Version>1.1.1</Version>
    <Nullable>enable</Nullable>
	<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	<HotReloadEnabled>true</HotReloadEnabled>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
	<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
	<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);LINUX</DefineConstants>
	<DefineConstants Condition="$([MSBuild]::IsOSPlatform('macOS'))">$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\NativePluginKit.SourceGenerators\NativePluginKit.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
	<None Include="..\NativePluginKit.SourceGenerators\bin\$(Configuration)\netstandard2.0\NativePluginKit.SourceGenerators.dll"
		  Pack="true"
		  PackagePath="analyzers/dotnet/cs"
		  Visible="false" />
  </ItemGroup>
</Project>
